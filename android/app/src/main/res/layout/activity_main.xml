<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0d12">

    <!-- First run progress container -->
    <LinearLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/progress_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Setting up Debian PRoot..."
            android:textColor="#58a6ff"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Terminal View -->
    <WebView
        android:id="@+id/terminal_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Termux Extra Keys Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#161b22"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_esc"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:background="#21262d"
                android:text="ESC"
                android:textColor="#f0f6fc"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_tab"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:background="#21262d"
                android:text="TAB"
                android:textColor="#f0f6fc"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_ctrl"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:background="#21262d"
                android:text="CTRL"
                android:textColor="#f0f6fc"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_alt"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:background="#21262d"
                android:text="ALT"
                android:textColor="#f0f6fc"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_dash"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:background="#21262d"
                android:text="-"
                android:textColor="#f0f6fc"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_slash"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:background="#21262d"
                android:text="/"
                android:textColor="#f0f6fc"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_pipe"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:background="#21262d"
                android:text="|"
                android:textColor="#f0f6fc"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_up"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:background="#21262d"
                android:text="▲"
                android:textColor="#f0f6fc"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_down"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:background="#21262d"
                android:text="▼"
                android:textColor="#f0f6fc"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_left"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:background="#21262d"
                android:text="◀"
                android:textColor="#f0f6fc"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_right"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:background="#21262d"
                android:text="▶"
                android:textColor="#f0f6fc"
                android:textSize="12sp" />

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
